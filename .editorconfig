root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{c,cpp,h,hpp,cu,cuh}]
indent_size = 4

[*.{py,sh}]
indent_size = 4

[*.{json,yaml,yml}]
indent_size = 2

[*.{html,css,js}]
indent_size = 2

[Makefile]
indent_style = tab
